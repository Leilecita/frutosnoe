<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_view"
    android:layout_marginLeft="8dp"
    android:layout_marginRight="8dp"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    card_view:cardCornerRadius="4dp"
    card_view:cardMaxElevation="4dp"
    android:backgroundTint="@color/color_background_cards"
    card_view:cardElevation="2dp"
    card_view:contentPadding="8dp"

    >

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="2dp"
        android:paddingRight="2dp"
        >


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/line2"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/user_name"
                android:layout_width="match_parent"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Leila del campo"
                android:fontFamily="@font/opensansregular"
                android:textColor="@color/FishyLetraDark"
                android:textSize="@dimen/general_text" />


            <ImageView
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:padding="2dp"
                android:layout_gravity="center"
                android:id="@+id/stateImage"
               />


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="2dp"
                android:id="@+id/priority"
                android:textColor="@color/word"
                android:text=""
                android:layout_gravity="center_vertical"
                android:textSize="@dimen/general_text"
                />


        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:orientation="horizontal"
            android:layout_below="@+id/line2"
            android:id="@+id/line_address"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/user_address"
                android:layout_width="match_parent"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Aristobulo del valle 3020"
                android:textColor="@color/FishyLetraDark"
                android:textSize="@dimen/general_text" />

            <TextView
                android:id="@+id/neighborhood"
                android:layout_width="match_parent"
                android:layout_weight="2"
                android:layout_height="match_parent"

                android:layout_gravity="center_vertical"
                android:gravity="right|center_vertical"
                android:text="Santa teresita"
                android:textColor="@color/FishyLetraDark"
                android:textSize="@dimen/general_text" />

        </LinearLayout>



        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/line23"
            android:paddingTop="2dp"
            android:layout_below="@+id/line_address"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/FishyLetraDark"
                android:text="$ "
                android:layout_gravity="center"
                android:textSize="@dimen/general_text"
                />

            <TextView
                android:layout_width="match_parent"
                android:layout_weight="1.3"
                android:layout_height="wrap_content"
                android:paddingRight="6dp"
                android:textSize="@dimen/general_text"
                android:layout_gravity="center"
                android:id="@+id/amount_order"
                android:textColor="@color/FishyLetraDark"
                android:text="900"

                />



            <TextView
                android:id="@+id/time"
                android:layout_width="match_parent"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text=""
                android:textColor="@color/FishyLetraDark"
                android:textSize="@dimen/general_text" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="8dp"
                android:id="@+id/horario"
                android:textColor="@color/FishyLetraDark"
                android:text=""
                android:layout_gravity="center_vertical"
                android:textSize="@dimen/general_text"
                />

        </LinearLayout>


    </RelativeLayout>


</androidx.cardview.widget.CardView>
